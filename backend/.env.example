# ═════════════════════════════════════════════════════════════════════
# Ozellar Maritime VIR — Backend Environment Example Template
# Copy to .env and configure for your environment.
# ═════════════════════════════════════════════════════════════════════

PORT=7071
NODE_ENV=development

# ── PostgreSQL Database Configuration ────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=vir
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_SSL=false

# ── Authentication & Security ────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
TOKEN_TTL=30d

# ── Azure Blob Storage (Photos & Attachments) ────────────────────────
AzureWebJobsStorage=your_azure_storage_connection_string
PHOTOS_ACCOUNT=deploymentvmstorage
PHOTOS_CONTAINER=ozellar-training

# ── App URLs & CORS ──────────────────────────────────────────────────
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
MAIL_SENDER=inspections@ozellar.com
