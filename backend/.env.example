# ═════════════════════════════════════════════════════════════════════
# Ozellar Maritime VIR — Backend Environment Example Template
# Copy to .env and configure for your environment.
# ═════════════════════════════════════════════════════════════════════

PORT=7071
NODE_ENV=development

# ── PostgreSQL Database Configuration ────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=vir
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_SSL=false

# ── Authentication & Security ────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
TOKEN_TTL=30d

# ── Azure Blob Storage (Photos & Attachments) ────────────────────────
AzureWebJobsStorage=your_azure_storage_connection_string
PHOTOS_ACCOUNT=deploymentvmstorage
PHOTOS_CONTAINER=ozellar-attachments

# ── App URLs & CORS ──────────────────────────────────────────────────
APP_URL=https://inspection.ozellar.com
ALLOWED_ORIGINS=https://inspection.ozellar.com,http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
MAIL_SENDER=inspections@ozellar.com

# ── Microsoft Graph Mail (Notifications) ─────────────────────────────
AZURE_TENANT_ID=fb77eaff-d671-41f7-87a7-f32a56e2f12b
AZURE_CLIENT_ID=baafb9e4-ef54-4c08-afce-7d1fc962f047
AZURE_CLIENT_SECRET=your_azure_client_secret_here
GRAPH_MAIL_ACTIVE=false
