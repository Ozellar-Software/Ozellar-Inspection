{
  "name": "@ozellar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:pg --external:pg-native --external:@azure/functions --external:@azure/identity --external:@azure/storage-blob --external:jose --external:bcryptjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "func start",
    "test:integration": "tsx test/integration.test.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.4.1",
    "@azure/storage-blob": "^12.24.0",
    "@ozellar/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "esbuild": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}